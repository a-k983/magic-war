extends Node
# Audio: one place to play every sound (autoload — call Audio.play("coin")
# from anywhere).
#   - Sound effects live in res://audio/sfx/<name>.wav, music in
#     res://audio/music/<name>.wav. They're generated by
#     tools/generate_audio.py; replace any file with a real recording of the
#     same name and it just works.
#   - Effects use a pool of players so overlapping sounds don't cut each
#     other off, plus a short per-sound cooldown so 30 coins picked up in
#     one frame don't turn into a wall of noise.
#   - Music and SFX each have their own bus, so the Settings sliders can
#     set their volumes separately. The buses are defined in
#     res://default_bus_layout.tres: creating them at runtime breaks the Web
#     export (its audio graph ends up with no path to the speakers = silence).
#     make_bus() is only a fallback if that file goes missing.
#   - Every button in the game clicks automatically (see _on_node_added).

const SFX_DIR := "res://audio/sfx/"
const MUSIC_DIR := "res://audio/music/"
const POOL_SIZE := 16
const MIN_GAP := 0.04          # Seconds before the same sound may play again
const MUSIC_FADE := 0.8        # Crossfade time between tracks

var sfx: Dictionary = {}       # name -> AudioStream (loaded on first use)
var last_played: Dictionary = {}  # name -> time (seconds) it last started
var pool: Array[AudioStreamPlayer] = []
var next_player: int = 0
var music_a: AudioStreamPlayer
var music_b: AudioStreamPlayer
var current_music: String = ""

func _ready() -> void:
	# Sounds keep playing while the game is paused (menus, level-up).
	process_mode = Node.PROCESS_MODE_ALWAYS
	make_bus("Music", -6.0)
	make_bus("SFX", -2.0)
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		pool.append(p)
	music_a = make_music_player()
	music_b = make_music_player()
	get_tree().node_added.connect(_on_node_added)

func make_bus(bus_name: String, volume_db: float) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var idx: int = AudioServer.bus_count - 1
	AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, "Master")
	AudioServer.set_bus_volume_db(idx, volume_db)

func make_music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "Music"
	p.volume_db = -80.0
	add_child(p)
	return p

# ---------- SOUND EFFECTS ----------

func play(sound: String, volume_db: float = 0.0, pitch_jitter: float = 0.05) -> void:
	var now: float = Time.get_ticks_msec() / 1000.0
	if now - last_played.get(sound, -1.0) < MIN_GAP:
		return
	last_played[sound] = now
	if not sfx.has(sound):
		sfx[sound] = load(SFX_DIR + sound + ".wav")
	if sfx[sound] == null:
		return
	# Round-robin through the pool: the oldest sound gets replaced first.
	var p: AudioStreamPlayer = pool[next_player]
	next_player = (next_player + 1) % POOL_SIZE
	p.stream = sfx[sound]
	p.volume_db = volume_db
	# Small random pitch change so repeated sounds don't feel robotic.
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()

# ---------- MUSIC ----------

func play_music(track: String) -> void:
	if track == current_music:
		return  # Already playing — e.g. title -> shop keeps the same tune
	current_music = track
	# Crossfade: fade the old player out while the new one fades in.
	var old: AudioStreamPlayer = music_a
	music_a = music_b
	music_b = old
	music_a.stream = load(MUSIC_DIR + track + ".wav")
	music_a.volume_db = -40.0
	music_a.play()
	var tween := create_tween().set_parallel(true)
	tween.tween_property(music_a, "volume_db", 0.0, MUSIC_FADE)
	tween.tween_property(old, "volume_db", -80.0, MUSIC_FADE)
	tween.chain().tween_callback(old.stop)

func stop_music() -> void:
	current_music = ""
	var tween := create_tween()
	tween.tween_property(music_a, "volume_db", -80.0, MUSIC_FADE)
	tween.tween_callback(music_a.stop)

# ---------- VOLUME (0.0 - 1.0, used by the Settings sliders) ----------

func get_volume(bus_name: String) -> float:
	return db_to_linear(AudioServer.get_bus_volume_db(AudioServer.get_bus_index(bus_name)))

func set_volume(bus_name: String, linear: float) -> void:
	var idx: int = AudioServer.get_bus_index(bus_name)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(linear, 0.0001)))
	AudioServer.set_bus_mute(idx, linear <= 0.001)

# ---------- AUTOMATIC BUTTON CLICKS ----------

func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		node.pressed.connect(play.bind("ui_click", -4.0, 0.0))
